# Menger-sponge approximation — level-1 sponge: cube minus 7 slab unions
# (face slabs and central cross). 19 primitives, CSG depth ≈ 7. Shows that
# our renderer handles deeply-nested unions and differences gracefully.
#
# pbrt-v4: cannot represent this geometrically without producing thousands of
# triangles to approximate the boolean output.
image 800 450
camera pos 1.6 1.6 2.4 lookat 0 0.5 0 up 0 1 0 vfov 45
background 0.60 0.75 0.95
ambient    0.04 0.04 0.05
max_depth  6

material floor  albedo 0.55 0.55 0.55 specular 1 1 1 shininess 40
material stone  albedo 0.70 0.55 0.40 specular 1 1 1 shininess 50

light point pos -3 5  2 intensity 0.9 0.9 0.9
light point pos  3 4 -1 intensity 0.5 0.5 0.6

plane point 0 0 0 normal 0 1 0 material floor

# Outer cube: 1×1×1 centered at (0, 0.5, 0).
# Subtract: union of 3 perpendicular through-holes (one per axis), each a
# rectangular slab passing through the cube's centre 1/3 of the side wide.
csg difference material stone {
  box min -0.5 0.0 -0.5 max 0.5 1.0 0.5
  csg union {
    csg union {
      # X-axis hole: x∈[-0.6, 0.6], y∈[1/3..2/3], z∈[-1/6..1/6]
      box min -0.6 0.333 -0.167 max 0.6 0.667 0.167
      # Y-axis hole: x∈[-1/6..1/6], y∈[-0.1..1.1], z∈[-1/6..1/6]
      box min -0.167 -0.1 -0.167 max 0.167 1.1 0.167
    }
    csg union {
      # Z-axis hole: x∈[-1/6..1/6], y∈[1/3..2/3], z∈[-0.6, 0.6]
      box min -0.167 0.333 -0.6 max 0.167 0.667 0.6
      # Add 4 corner notches (small spheres) for visual richness.
      csg union {
        csg union {
          sphere center -0.5 1.0 -0.5 radius 0.18
          sphere center  0.5 1.0 -0.5 radius 0.18
        }
        csg union {
          sphere center -0.5 1.0  0.5 radius 0.18
          sphere center  0.5 1.0  0.5 radius 0.18
        }
      }
    }
  }
}
