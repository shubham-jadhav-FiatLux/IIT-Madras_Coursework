# All four primitives in a row, matte shading, one point light.
image 800 450
camera pos 0 1.8 4.2 lookat 0 0.5 -0.5 up 0 1 0 vfov 45
background 0.55 0.70 0.92
ambient    0.05 0.05 0.06
max_depth  4

material floor    albedo 0.60 0.60 0.60 specular 1 1 1 shininess 20
material red      albedo 0.80 0.20 0.20 specular 1 1 1 shininess 50
material green    albedo 0.20 0.70 0.25 specular 1 1 1 shininess 50
material blue     albedo 0.20 0.35 0.85 specular 1 1 1 shininess 50
material yellow   albedo 0.85 0.75 0.15 specular 1 1 1 shininess 50

light point pos -2 6  3 intensity 0.9 0.9 0.9
light point pos  3 4 -1 intensity 0.4 0.4 0.5

plane point 0 0 0 normal 0 1 0 material floor

sphere   center -1.8 0.5 -0.5 radius 0.5 material red
box      min    -0.8 0.0 -1.0 max 0.2 1.0 0.0 material green
cylinder base    0.8 0.0 -0.5 radius 0.4 height 1.0 material blue
sphere   center  2.2 0.35 -0.3 radius 0.35 material yellow
