# Swiss-cheese box: solid box minus a 3×3×3 grid of spherical drillings.
# Topology: difference(box, union(s1, s2, ..., s27))
# The union is a balanced binary tree of 27 spheres (depth ~5).
# Demonstrates the algorithmic capability gap vs pbrt-v4 (no CSG):
# pbrt-v4 cannot represent this; meshing 27 boolean drillings with smooth
# normals would need thousands of triangles vs our 28 analytical primitives.
image 800 450
camera pos 0 1.2 3.0 lookat 0 0.4 -0.8 up 0 1 0 vfov 45
background 0.60 0.75 0.95
ambient    0.04 0.04 0.05
max_depth  6

material gray   albedo 0.55 0.55 0.55 specular 1 1 1 shininess 40
material cheese albedo 0.95 0.85 0.30 specular 1 1 1 shininess 60

light point pos -3 5  2 intensity 0.8 0.8 0.8
light point pos  3 4 -1 intensity 0.5 0.5 0.6

plane point 0 0 0 normal 0 1 0 material gray

# Box: x∈[-0.8,0.8], y∈[0.1,0.9], z∈[-1.6,0.0]. Drilling spheres on 3×3×3 grid:
# x ∈ {-0.5, 0.0, 0.5}, y ∈ {0.3, 0.5, 0.7}, z ∈ {-1.3, -0.8, -0.3}, radius 0.13.
csg difference material cheese {
  box min -0.8 0.1 -1.6 max 0.8 0.9 0.0
  csg union {
    csg union {
      csg union {
        csg union {
          sphere center -0.5 0.3 -1.3 radius 0.13
          sphere center  0.0 0.3 -1.3 radius 0.13
        }
        csg union {
          sphere center  0.5 0.3 -1.3 radius 0.13
          sphere center -0.5 0.3 -0.8 radius 0.13
        }
      }
      csg union {
        csg union {
          sphere center  0.0 0.3 -0.8 radius 0.13
          sphere center  0.5 0.3 -0.8 radius 0.13
        }
        csg union {
          sphere center -0.5 0.3 -0.3 radius 0.13
          sphere center  0.0 0.3 -0.3 radius 0.13
        }
      }
    }
    csg union {
      csg union {
        csg union {
          csg union {
            sphere center  0.5 0.3 -0.3 radius 0.13
            sphere center -0.5 0.5 -1.3 radius 0.13
          }
          csg union {
            sphere center  0.0 0.5 -1.3 radius 0.13
            sphere center  0.5 0.5 -1.3 radius 0.13
          }
        }
        csg union {
          csg union {
            sphere center -0.5 0.5 -0.8 radius 0.13
            sphere center  0.0 0.5 -0.8 radius 0.13
          }
          csg union {
            sphere center  0.5 0.5 -0.8 radius 0.13
            sphere center -0.5 0.5 -0.3 radius 0.13
          }
        }
      }
      csg union {
        csg union {
          csg union {
            sphere center  0.0 0.5 -0.3 radius 0.13
            sphere center  0.5 0.5 -0.3 radius 0.13
          }
          csg union {
            sphere center -0.5 0.7 -1.3 radius 0.13
            sphere center  0.0 0.7 -1.3 radius 0.13
          }
        }
        csg union {
          csg union {
            csg union {
              sphere center  0.5 0.7 -1.3 radius 0.13
              sphere center -0.5 0.7 -0.8 radius 0.13
            }
            csg union {
              sphere center  0.0 0.7 -0.8 radius 0.13
              sphere center  0.5 0.7 -0.8 radius 0.13
            }
          }
          csg union {
            sphere center -0.5 0.7 -0.3 radius 0.13
            csg union {
              sphere center  0.0 0.7 -0.3 radius 0.13
              sphere center  0.5 0.7 -0.3 radius 0.13
            }
          }
        }
      }
    }
  }
}
