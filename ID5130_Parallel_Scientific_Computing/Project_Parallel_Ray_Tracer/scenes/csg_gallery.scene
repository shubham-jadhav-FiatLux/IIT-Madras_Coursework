# Union, intersection, difference side-by-side.
image 800 450
camera pos 0 1.6 4.2 lookat 0 0.5 -0.5 up 0 1 0 vfov 45
background 0.55 0.70 0.92
ambient    0.05 0.05 0.06
max_depth  4

material floor  albedo 0.60 0.60 0.60 specular 1 1 1 shininess 20
material red    albedo 0.80 0.20 0.20 specular 1 1 1 shininess 60
material green  albedo 0.20 0.70 0.25 specular 1 1 1 shininess 60
material blue   albedo 0.20 0.35 0.85 specular 1 1 1 shininess 60

light point pos -2 6  3 intensity 0.9 0.9 0.9
light point pos  3 4 -1 intensity 0.4 0.4 0.5

plane point 0 0 0 normal 0 1 0 material floor

# Left: union of box and sphere (fused blob).
csg union material red {
    box    min -2.3 0.0 -1.0 max -1.3 1.0 0.0
    sphere center -1.3 0.5 -0.5 radius 0.6
}

# Center: intersection of two overlapping spheres (lens shape).
csg intersection material green {
    sphere center -0.25 0.6 -0.5 radius 0.7
    sphere center  0.25 0.6 -0.5 radius 0.7
}

# Right: difference -- box with a spherical bite taken out of a corner.
csg difference material blue {
    box    min 1.3 0.0 -1.0 max 2.3 1.0 0.0
    sphere center 2.3 1.0 0.0 radius 0.55
}
