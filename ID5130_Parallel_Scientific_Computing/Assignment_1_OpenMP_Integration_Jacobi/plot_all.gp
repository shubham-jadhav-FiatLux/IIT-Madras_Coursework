#!/usr/bin/gnuplot
# =====================================================================
# ID5130 Assignment 1 — All Plots
# Usage:  gnuplot plot_all.gp
# Needs:  jacobi_serial_delta0.1000_y0.5.csv
#         jacobi_parallel_p8_delta0.1000_y0.5.csv
#         (both generated by: ./q2_jacobi 8 0.1)
# =====================================================================

# --- Global terminal ---
set terminal pngcairo enhanced size 1000,700 font "Helvetica,14" lw 1.5

# --- Muted color palette ---
C1 = "#2166AC"
C2 = "#B2182B"
C3 = "#2CA02C"
C4 = "#7B4173"
CG = "#888888"

# --- Minimalist grid ---
set style line 100 lt 1 lc rgb "#E8E8E8" lw 0.4
set grid back ls 100
set border 3 lw 1.2            # bottom + left only
set tics nomirror


# =====================================================================
# PLOT 1 — Q2(a): phi vs x at y = 0.5
# =====================================================================
set output "plot1_q2a_phi_vs_x.png"
set datafile separator ","

set xlabel "x"
set ylabel "{/Symbol f}(x, y = 0.5)"
set title "{/=16 Q2(a):  Jacobi solution at  y = 0.5,   {/Symbol D} = 0.1}"
set key top left spacing 1.3

plot "jacobi_serial_delta0.1000_y0.5.csv" \
       u 1:3 skip 1 w lines lw 2.5 lc rgb C1 \
       title "Exact:  {/Symbol f} = (x^2 - 1)(y^2 - 1)", \
     "" u 1:2 skip 1 w points pt 6 ps 1.4 lc rgb C2 \
       title "Numerical  (Jacobi, 400 iter)"

print "  [1/6] plot1_q2a_phi_vs_x.png"


# =====================================================================
# PLOT 2 — Q2(c): Serial vs Parallel verification
# =====================================================================
set output "plot2_q2c_verification.png"

set title "{/=16 Q2(c):  Serial vs Parallel verification  ({/Symbol D} = 0.1)}"
set key top left spacing 1.3

plot "jacobi_serial_delta0.1000_y0.5.csv" \
       u 1:3 skip 1 w lines lw 2.5 lc rgb C1 \
       title "Exact", \
     "" u 1:2 skip 1 w points pt 4 ps 1.5 lc rgb C2 \
       title "Serial Jacobi", \
     "jacobi_parallel_p8_delta0.1000_y0.5.csv" \
       u 1:2 skip 1 w points pt 8 ps 1.0 lc rgb C3 \
       title "Parallel Jacobi  (p = 8)"

print "  [2/6] plot2_q2c_verification.png"


# =====================================================================
# PLOT 3 — Q2(c): Time vs Grid Size
# =====================================================================
set output "plot3_q2c_time_vs_gridsize.png"
set datafile separator whitespace

set xlabel "Grid spacing  ({/Symbol D})"
set ylabel "Execution time  (seconds)"
set title "{/=16 Q2(c):  Time vs grid size  — serial and parallel (p = 8)}"
set key top left spacing 1.3

set logscale xy
set format x "10^{%L}"
set format y "10^{%L}"
set xrange [0.2:0.003]

$Q2C << EOD
0.1    0.000225   0.001050
0.01   2.255950   0.685345
0.005  33.827119  9.614774
EOD

plot $Q2C u 1:2 w linespoints pt 7 ps 1.5 lw 2.5 lc rgb C1 title "Serial", \
     $Q2C u 1:3 w linespoints pt 5 ps 1.5 lw 2.5 lc rgb C2 title "Parallel (p = 8)"

print "  [3/6] plot3_q2c_time_vs_gridsize.png"


# =====================================================================
# PLOT 4a — Q2(d): Time vs Threads
# =====================================================================
set output "plot4a_q2d_time_vs_threads.png"

unset logscale
set format x "%g"
set format y "%g"
set autoscale y

set xlabel "Number of threads  (p)"
set ylabel "Execution time  (seconds)"
set title "{/=16 Q2(d):  Time vs threads   ({/Symbol D} = 0.005,  401 x 401)}"
set key top right spacing 1.3

set xrange [1:18]
set xtics (2, 4, 8, 16)

Ts = 35.341     # serial baseline

$Q2D << EOD
2   16.810592
4    9.370655
8   11.204548
16  22.204227
EOD

set arrow 1 from 1,Ts to 18,Ts nohead lw 2 dt (10,6) lc rgb C1
set label 1 sprintf("Serial = %.1f s", Ts) at 9.5,37.5 tc rgb C1

plot $Q2D u 1:2 w linespoints pt 5 ps 1.6 lw 2.5 lc rgb C2 title "Parallel"

unset arrow 1
unset label 1

print "  [4a/6] plot4a_q2d_time_vs_threads.png"


# =====================================================================
# PLOT 4b — Q2(d): Speedup vs Threads
# =====================================================================
set output "plot4b_q2d_speedup_vs_threads.png"

set xlabel "Number of threads  (p)"
set ylabel "Speedup   S  =  T_{serial}  /  T_{parallel}"
set title "{/=16 Q2(d):  Speedup vs threads   ({/Symbol D} = 0.005)}"
set key top left spacing 1.3

set xrange [1:18]
set yrange [0:18]
set xtics (2, 4, 8, 16)

set arrow 1 from 1,1 to 18,18 nohead lw 1.2 dt (8,5) lc rgb CG
set label 1 "Ideal" at 13.5,15 tc rgb CG font ",12"

plot $Q2D u 1:(Ts/$2) w linespoints pt 7 ps 1.6 lw 2.5 lc rgb C3 title "Actual speedup"

unset arrow 1
unset label 1
set autoscale xy
set xtics auto

print "  [4b/6] plot4b_q2d_speedup_vs_threads.png"


# =====================================================================
# PLOT 5a — Q1(b): Monte Carlo convergence
# =====================================================================
set output "plot5a_q1b_convergence.png"

set xlabel "N  (random points)"
set ylabel "Relative error  (%)"
set title "{/=16 Q1(b):  Monte Carlo convergence}"
set key top right spacing 1.3

set logscale xy
set format x "10^{%L}"
set format y "10^{%L}"
set autoscale xy

$MC_ERR << EOD
100      21.5462
1000      2.9574
10000     0.7694
100000    0.0853
1000000   0.0180
EOD

# 1/sqrt(N) reference: passes through (100, 21.55)
f(x) = 215.5 / sqrt(x)

plot $MC_ERR u 1:2 w linespoints pt 7 ps 1.5 lw 2.5 lc rgb C1 title "MC error", \
     f(x) w lines lw 1.5 dt (8,5) lc rgb CG title "~ 1 / {/Symbol \326}N"

print "  [5a/6] plot5a_q1b_convergence.png"


# =====================================================================
# PLOT 5b — Q1(b): Monte Carlo timing
# =====================================================================
set output "plot5b_q1b_timing.png"

set xlabel "N  (random points)"
set ylabel "Execution time  (seconds)"
set title "{/=16 Q1(b):  Monte Carlo — serial vs parallel time}"
set key bottom right spacing 1.3

set logscale xy
set format x "10^{%L}"
set format y "10^{%L}"
set autoscale xy

# N   serial   p=2      p=4      p=8
$MC_T << EOD
100      0.000004  0.000125  0.000168  0.000364
1000     0.000028  0.000020  0.000016  0.000011
10000    0.000274  0.000141  0.000108  0.000056
100000   0.002834  0.001409  0.001045  0.000523
1000000  0.028915  0.014001  0.010318  0.005270
EOD

plot $MC_T u 1:2 w linespoints pt 7  ps 1.3 lw 2.2 lc rgb C1 title "Serial", \
     $MC_T u 1:3 w linespoints pt 5  ps 1.3 lw 1.8 lc rgb C2 title "p = 2", \
     $MC_T u 1:4 w linespoints pt 9  ps 1.3 lw 1.8 lc rgb C3 title "p = 4", \
     $MC_T u 1:5 w linespoints pt 13 ps 1.3 lw 1.8 lc rgb C4 title "p = 8"

print "  [5b/6] plot5b_q1b_timing.png"


# =====================================================================
# PLOT 6 — Q1(a): Riemann timing (bar chart)
# =====================================================================
set output "plot6_q1a_riemann.png"

unset logscale
set format x ""
set format y "%g"
set autoscale y

set xlabel ""
set ylabel "Execution time  (ms)"
set title "{/=16 Q1(a):  Riemann integration — serial vs parallel time}"
set key off

set style fill solid 0.75 border -1
set boxwidth 0.6
set yrange [0:11]

set grid ytics ls 100
unset grid             # x-grid off for bar chart
set grid ytics back ls 100

# label  time_ms  color_index
$Q1A << EOD
"Serial"  0.092   1
"p = 2"   0.267   2
"p = 4"   0.311   2
"p = 8"   8.633   2
EOD

# Use color_index: 1 → blue, 2 → red
plot $Q1A u 0:2:($3==1 ? 0x2166AC : 0xB2182B):xtic(1) w boxes lc rgb var notitle, \
     $Q1A u 0:2:(sprintf("%.3f", $2)) w labels offset 0,0.7 font ",12" notitle

print "  [6/6] plot6_q1a_riemann.png"


# =====================================================================
print ""
print "All 7 plots generated. (4a and 4b are two panels of Q2d)"
print "Files: plot1_*.png  plot2_*.png  plot3_*.png  plot4a_*.png"
print "       plot4b_*.png plot5a_*.png plot5b_*.png plot6_*.png"
# =====================================================================
